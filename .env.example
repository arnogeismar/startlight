# Default state repository (owner/name). Users can override it on the sign-in screen.
VITE_STATE_REPO=my-org/contract-hub-state

# "Sign in with GitHub": the OAuth App's Client ID (public) and the URL of the deployed auth-worker.
VITE_GITHUB_CLIENT_ID=
VITE_OAUTH_EXCHANGE_URL=https://contract-hub-auth.YOUR-SUBDOMAIN.workers.dev
